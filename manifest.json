{
  "manifest_version": 3,
  "name": "Tab Swapper",
  "version": "1.0.0",
  "description": "Swap between the two last active tabs in the current window using a keyboard shortcut.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-last-tab": {
      "suggested_key": {
        "default": "Ctrl+Period"
      },
      "description": "Swap to the previously active tab in the current window"
    }
  }
}
